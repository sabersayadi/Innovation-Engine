# Choose one or more AI providers (or configure them in the web UI under AI Settings):
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenRouter, Groq, etc.)
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=qwen2.5:32b

# Optional web search backends (if omitted, uses Provider-Native Search if Gemini/OpenAI/Claude key is set)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
JINA_API_KEY=

# Optional European Patent Office OPS credentials (free registration at developers.epo.org)
EPO_KEY=
EPO_SECRET=

# Optional Aalto ACRIS API key (for Research tab)
ACRIS_API_KEY=
